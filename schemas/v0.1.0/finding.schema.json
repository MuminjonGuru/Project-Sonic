{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "exposure_statement": {
          "const": "static-observable-condition",
          "title": "Exposure Statement",
          "type": "string"
        },
        "verification_state": {
          "enum": [
            "unreviewed",
            "confirmed",
            "rejected",
            "uncertain",
            "disputed",
            "disclosure-pending"
          ],
          "title": "Verification State",
          "type": "string"
        }
      },
      "required": [
        "verification_state",
        "exposure_statement"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "native_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Label"
        },
        "normalized": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized"
        }
      },
      "title": "Confidence",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "blob_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Blob Sha256",
          "type": "string"
        },
        "byte_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte End"
        },
        "byte_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Start"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "origin": {
          "enum": [
            "native-observed",
            "mechanically-derived",
            "researcher-adjudicated"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "blob_sha256"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "FindingMessage": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "FindingMessage",
      "type": "object"
    },
    "Fingerprints": {
      "additionalProperties": false,
      "properties": {
        "candidate_equivalence_v1": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Equivalence V1",
          "type": "string"
        },
        "native": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native"
        },
        "record_v1": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record V1",
          "type": "string"
        }
      },
      "required": [
        "record_v1",
        "candidate_equivalence_v1"
      ],
      "title": "Fingerprints",
      "type": "object"
    },
    "JsonValue": {},
    "Location": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Artifact Path",
          "type": "string"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Column"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "required": [
        "artifact_path"
      ],
      "title": "Location",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "tool_id": {
          "minLength": 1,
          "title": "Tool Id",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "tool_version",
        "adapter_id",
        "adapter_version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "help_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Help Uri"
        },
        "mappings": {
          "items": {
            "$ref": "#/$defs/TaxonomyMapping"
          },
          "title": "Mappings",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "native_id": {
          "minLength": 1,
          "title": "Native Id",
          "type": "string"
        }
      },
      "required": [
        "native_id"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Severity": {
      "additionalProperties": false,
      "properties": {
        "mapping_id": {
          "minLength": 1,
          "title": "Mapping Id",
          "type": "string"
        },
        "native_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Label"
        },
        "native_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Score"
        },
        "normalized": {
          "enum": [
            "informational",
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ],
          "title": "Normalized",
          "type": "string"
        }
      },
      "required": [
        "normalized",
        "mapping_id"
      ],
      "title": "Severity",
      "type": "object"
    },
    "TaxonomyMapping": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "native-observed",
            "mechanically-derived",
            "researcher-adjudicated"
          ],
          "title": "Origin",
          "type": "string"
        },
        "taxonomy": {
          "minLength": 1,
          "title": "Taxonomy",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "taxonomy",
        "value",
        "origin"
      ],
      "title": "TaxonomyMapping",
      "type": "object"
    }
  },
  "$id": "urn:agentsec-evidence:schema:v0.1.0:finding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessment": {
      "$ref": "#/$defs/Assessment"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "domain": {
      "const": "static",
      "default": "static",
      "title": "Domain",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "execution_id": {
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "fingerprints": {
      "$ref": "#/$defs/Fingerprints"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/Location"
      },
      "title": "Locations",
      "type": "array"
    },
    "message": {
      "$ref": "#/$defs/FindingMessage"
    },
    "native_extension": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Native Extension",
      "type": "object"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "rule": {
      "$ref": "#/$defs/Rule"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "target_snapshot_id": {
      "minLength": 1,
      "title": "Target Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "run_id",
    "execution_id",
    "target_snapshot_id",
    "producer",
    "rule",
    "message",
    "severity",
    "confidence",
    "locations",
    "evidence",
    "assessment",
    "fingerprints"
  ],
  "title": "Finding",
  "type": "object"
}
