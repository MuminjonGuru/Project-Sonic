{
  "$defs": {
    "DependencyBoundaryCell": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "enum": [
            "dev-dependency-empty-v1",
            "dev-dependency-unresolved-v1",
            "dev-dependency-malformed-v1",
            "dev-dependency-unsupported-v1"
          ],
          "title": "Case Id",
          "type": "string"
        },
        "cell_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cell Id",
          "type": "string"
        },
        "coverage": {
          "const": "not-measured",
          "default": "not-measured",
          "title": "Coverage",
          "type": "string"
        },
        "expectation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expectation Sha256",
          "type": "string"
        },
        "finding_records": {
          "default": null,
          "title": "Finding Records",
          "type": "null"
        },
        "input_files": {
          "items": {
            "$ref": "#/$defs/PlanFile"
          },
          "title": "Input Files",
          "type": "array"
        },
        "producer_invocations": {
          "const": 0,
          "default": 0,
          "title": "Producer Invocations",
          "type": "integer"
        },
        "repetition": {
          "maximum": 3,
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "selected_paths": {
          "default": [
            "uv.lock"
          ],
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "const": "uv.lock",
              "type": "string"
            }
          ],
          "title": "Selected Paths",
          "type": "array"
        },
        "state": {
          "const": "not-attempted",
          "default": "not-attempted",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "case_id",
        "repetition",
        "input_files",
        "expectation_sha256"
      ],
      "title": "DependencyBoundaryCell",
      "type": "object"
    },
    "DependencyDatabase": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "exclusiveMinimum": 0,
          "maximum": 2147483648,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "title": "DependencyDatabase",
      "type": "object"
    },
    "PlanFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 2097152,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "title": "PlanFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cells": {
      "items": {
        "$ref": "#/$defs/DependencyBoundaryCell"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Cells",
      "type": "array"
    },
    "contract": {
      "const": "benchmark-dependency-boundary-dry-run-v1",
      "default": "benchmark-dependency-boundary-dry-run-v1",
      "title": "Contract",
      "type": "string"
    },
    "database": {
      "$ref": "#/$defs/DependencyDatabase"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "limitations": {
      "default": [
        "Four existing development input boundaries; no new target or scanner",
        "Malformed/unsupported format remains a blocked producer failure, not clean analysis",
        "No output is not zero findings; no-package exit is preserved with missing-output state",
        "Only verified partial/completed attempts can be reused; no retry or bypass",
        "Historical engineering expectations are not independent labels or scoring"
      ],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "limits": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          }
        ]
      },
      "title": "Limits",
      "type": "object"
    },
    "metric_scoring_implemented": {
      "const": false,
      "default": false,
      "title": "Metric Scoring Implemented",
      "type": "boolean"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_semantic_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Semantic Sha256",
      "type": "string"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "plan_valid": {
      "const": true,
      "default": true,
      "title": "Plan Valid",
      "type": "boolean"
    },
    "resume_implemented": {
      "const": true,
      "default": true,
      "title": "Resume Implemented",
      "type": "boolean"
    },
    "runtime_readiness": {
      "const": "containers-not-checked",
      "default": "containers-not-checked",
      "title": "Runtime Readiness",
      "type": "string"
    },
    "tool_images": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "title": "Tool Images",
      "type": "array"
    },
    "treatment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Treatment Sha256",
      "type": "string"
    },
    "validation_scope": {
      "const": "fixed-development-input-boundary-byte-bindings",
      "default": "fixed-development-input-boundary-byte-bindings",
      "title": "Validation Scope",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_sha256",
    "plan_semantic_sha256",
    "treatment_sha256",
    "implementation_sha256",
    "cells",
    "database",
    "limits",
    "tool_images"
  ],
  "title": "DependencyBoundaryPreview",
  "type": "object"
}
