{
  "$defs": {
    "AttemptEvidence": {
      "additionalProperties": false,
      "properties": {
        "bundle_files": {
          "$ref": "#/$defs/RetainedManifest"
        },
        "finding_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Records"
        },
        "per_file_completion": {
          "enum": [
            "unknown",
            "not-run"
          ],
          "title": "Per File Completion",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "scanner_invocations": {
          "maximum": 1,
          "minimum": 0,
          "title": "Scanner Invocations",
          "type": "integer"
        },
        "semantic_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Sha256",
          "type": "string"
        },
        "state": {
          "enum": [
            "partial-analysis",
            "refused",
            "execution-failed"
          ],
          "title": "State",
          "type": "string"
        },
        "terminal_state": {
          "title": "Terminal State",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "terminal_state",
        "semantic_sha256",
        "bundle_files",
        "state",
        "scanner_invocations",
        "per_file_completion"
      ],
      "title": "AttemptEvidence",
      "type": "object"
    },
    "RetainedEntry": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 16777216,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "title": "RetainedEntry",
      "type": "object"
    },
    "RetainedManifest": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/RetainedEntry"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "title": "RetainedManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^attempt_[0-9a-f]{32}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "contract": {
      "const": "benchmark-attempt-finish-v1",
      "default": "benchmark-attempt-finish-v1",
      "title": "Contract",
      "type": "string"
    },
    "duration_ns": {
      "minimum": 0,
      "title": "Duration Ns",
      "type": "integer"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "error_kind": {
      "anyOf": [
        {
          "enum": [
            "runner-or-verification-error",
            "keyboard-interrupt"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Kind"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttemptEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "start_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Start Sha256",
      "type": "string"
    },
    "state": {
      "enum": [
        "partial-analysis",
        "refused",
        "execution-failed",
        "interrupted"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "start_sha256",
    "ended_at",
    "duration_ns",
    "state"
  ],
  "title": "AttemptFinish",
  "type": "object"
}
