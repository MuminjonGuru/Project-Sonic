{
  "$defs": {
    "RunState": {
      "enum": [
        "created",
        "acquiring",
        "ready",
        "planned",
        "running",
        "captured",
        "parsing",
        "normalizing",
        "validating",
        "complete",
        "partial",
        "timed-out",
        "cancelled",
        "execution-failed",
        "parse-failed",
        "validation-failed",
        "rejected",
        "finalized"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "$id": "urn:agentsec-evidence:schema:v0.1.0:run-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "component": {
      "minLength": 1,
      "title": "Component",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "next_state": {
      "$ref": "#/$defs/RunState"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "previous_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "occurred_at",
    "component",
    "next_state",
    "reason"
  ],
  "title": "RunEvent",
  "type": "object"
}
