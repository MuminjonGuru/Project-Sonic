{
  "$defs": {
    "ResearchInput": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "byte_length",
        "media_type"
      ],
      "title": "ResearchInput",
      "type": "object"
    }
  },
  "$id": "urn:agentsec-evidence:schema:semgrep-research-v1:scope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "semgrep-research-scope-v1",
      "default": "semgrep-research-scope-v1",
      "title": "Contract",
      "type": "string"
    },
    "execution_authorization": {
      "const": "not-granted",
      "default": "not-granted",
      "title": "Execution Authorization",
      "type": "string"
    },
    "policy_context": {
      "const": "full-parent-required",
      "default": "full-parent-required",
      "title": "Policy Context",
      "type": "string"
    },
    "policy_files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResearchInput"
      },
      "maxItems": 64,
      "title": "Policy Files",
      "type": "array"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "selected_files": {
      "items": {
        "$ref": "#/$defs/ResearchInput"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Selected Files",
      "type": "array"
    },
    "selection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Sha256",
      "type": "string"
    },
    "target_snapshot_id": {
      "minLength": 1,
      "title": "Target Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "target_snapshot_id",
    "selection_sha256",
    "profile_sha256",
    "selected_files"
  ],
  "title": "SemgrepResearchScope",
  "type": "object"
}
