{
  "$defs": {
    "PilotRow": {
      "additionalProperties": false,
      "properties": {
        "duration_ns": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ns"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "finding_records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Records"
        },
        "package_identities": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Identities"
        },
        "reasons": {
          "default": [
            "not-attempted"
          ],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "repetition": {
          "maximum": 3,
          "minimum": 1,
          "title": "Repetition",
          "type": "integer"
        },
        "semantic_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Sha256"
        },
        "stage": {
          "$ref": "#/$defs/PilotStage"
        },
        "state": {
          "default": "not-run",
          "enum": [
            "not-run",
            "refused",
            "failed",
            "partial",
            "complete"
          ],
          "title": "State",
          "type": "string"
        },
        "unit": {
          "enum": [
            "native-rule-reports",
            "package-advisory-occurrences",
            "package-identities"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "repetition",
        "stage",
        "unit"
      ],
      "title": "PilotRow",
      "type": "object"
    },
    "PilotStage": {
      "enum": [
        "semgrep-research",
        "semgrep-policy",
        "agent-audit",
        "osv-direct",
        "syft",
        "osv-sbom"
      ],
      "type": "string"
    },
    "PublicPilotEvidence": {
      "additionalProperties": false,
      "properties": {
        "finding_records": {
          "default": null,
          "title": "Finding Records",
          "type": "null"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/PilotRow"
          },
          "maxItems": 18,
          "minItems": 18,
          "title": "Rows",
          "type": "array"
        },
        "run_id": {
          "pattern": "^public-pilot-[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "scanner_invocations": {
          "const": 18,
          "default": 18,
          "title": "Scanner Invocations",
          "type": "integer"
        },
        "semantic_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Sha256",
          "type": "string"
        },
        "state": {
          "const": "partial-analysis",
          "default": "partial-analysis",
          "title": "State",
          "type": "string"
        },
        "syntax_invocations": {
          "const": 3,
          "default": 3,
          "title": "Syntax Invocations",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "manifest_sha256",
        "semantic_sha256",
        "rows"
      ],
      "title": "PublicPilotEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^attempt_[0-9a-f]{32}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "contract": {
      "const": "benchmark-public-pilot-attempt-finish-v1",
      "default": "benchmark-public-pilot-attempt-finish-v1",
      "title": "Contract",
      "type": "string"
    },
    "duration_ns": {
      "minimum": 0,
      "title": "Duration Ns",
      "type": "integer"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "error_kind": {
      "anyOf": [
        {
          "enum": [
            "runner-or-verification-error",
            "keyboard-interrupt"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Kind"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicPilotEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "start_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Start Sha256",
      "type": "string"
    },
    "state": {
      "enum": [
        "partial-analysis",
        "execution-failed",
        "interrupted"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "start_sha256",
    "ended_at",
    "duration_ns",
    "state"
  ],
  "title": "PublicPilotFinish",
  "type": "object"
}
