{
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^attempt_[0-9a-f]{32}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$",
      "title": "Case Id",
      "type": "string"
    },
    "cell_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cell Id",
      "type": "string"
    },
    "contract": {
      "const": "benchmark-attempt-start-v1",
      "default": "benchmark-attempt-start-v1",
      "title": "Contract",
      "type": "string"
    },
    "ordinal": {
      "maximum": 39,
      "minimum": 1,
      "title": "Ordinal",
      "type": "integer"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "previous_finish_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Finish Sha256"
    },
    "repetition": {
      "maximum": 3,
      "minimum": 1,
      "title": "Repetition",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "ordinal",
    "cell_id",
    "case_id",
    "repetition",
    "plan_sha256",
    "previous_finish_sha256",
    "started_at"
  ],
  "title": "AttemptStart",
  "type": "object"
}
