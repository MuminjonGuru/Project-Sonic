{
  "$defs": {
    "RunState": {
      "enum": [
        "created",
        "acquiring",
        "ready",
        "planned",
        "running",
        "captured",
        "parsing",
        "normalizing",
        "validating",
        "complete",
        "partial",
        "timed-out",
        "cancelled",
        "execution-failed",
        "parse-failed",
        "validation-failed",
        "rejected",
        "finalized"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "$id": "urn:agentsec-evidence:schema:v0.1.0:run",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_ids": {
      "items": {
        "type": "string"
      },
      "title": "Execution Ids",
      "type": "array"
    },
    "finalized_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finalized At"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_label": {
      "minLength": 1,
      "title": "Run Label",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_hash_version": {
      "default": "run-semantic-v2",
      "enum": [
        "run-semantic-v2",
        "agent-run-semantic-v1"
      ],
      "title": "Semantic Hash Version",
      "type": "string"
    },
    "semantic_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Sha256"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "target_snapshot_id": {
      "minLength": 1,
      "title": "Target Snapshot Id",
      "type": "string"
    },
    "terminal_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "run_label",
    "profile_id",
    "target_snapshot_id",
    "state",
    "created_at",
    "config_sha256"
  ],
  "title": "RunRecord",
  "type": "object"
}
